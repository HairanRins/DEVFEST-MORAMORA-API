DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL — the direct endpoint is used by default, including for migrations.
# Keep the query string (sslmode=require&channel_binding=require) from the Neon console.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional pooler endpoint, for application traffic only.
# Enable it explicitly with DJANGO_DB_USE_POOLED=true; never migrate through the pooler.
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DJANGO_DB_USE_POOLED=false
DB_CONN_MAX_AGE=0

# Legacy local PostgreSQL (used only when DATABASE_URL is empty).
# DB_ENGINE=postgresql
# DB_NAME=neondb
# DB_USER=postgres
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# Optional Neon services present in .env (not consumed by Django yet).
NEON_AUTH_BASE_URL=https://ep-xxxxx.neonauth.REGION.aws.neon.tech/neondb/auth
AWS_ENDPOINT_URL_S3=https://xxxxx.storage.REGION.aws.neon.tech
AWS_ACCESS_KEY_ID=replace-with-neon-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-neon-s3-secret-key
AWS_REGION=eu-central-1
S3_BUCKET=buckets-media
NEON_REALTIME_URL=https://ep-xxxxx.rt.REGION.aws.neon.tech/
NEON_REALTIME_SECRET=replace-with-neon-realtime-secret

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
LOGIN_RATE_LIMIT=5/min

WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
WEBSOCKET_MAX_IMAGE_SIZE=5242880
WEBSOCKET_MAX_IMAGE_PIXELS=20000000
# Upload vidéo (POST /api/detection/video/)
DETECTION_MAX_VIDEO_SIZE=52428800
DETECTION_MAX_VIDEO_DURATION=120
DETECTION_VIDEO_SAMPLE_FPS=1
DETECTION_VIDEO_MAX_FRAMES=120
DETECTION_VIDEO_MAX_ANNOTATED_FRAMES=10
